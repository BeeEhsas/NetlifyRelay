{
  "log": {
    "loglevel": "warning"
  },
  "inbounds": [
    {
      "tag": "socks",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "udp": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "proxy",
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "relay.example.com",
            "port": 443,
            "users": [
              {
                "id": "00000000-0000-0000-0000-000000000000",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "relay.example.com",
          "fingerprint": "chrome",
          "alpn": [
            "h2"
          ]
        },
        "xhttpSettings": {
          "path": "/your-secret-path",
          "host": "relay.example.com",
          "mode": "packet-up",
          "xPaddingBytes": "1-1",
          "xPaddingObfsMode": true,
          "xPaddingKey": "t",
          "xPaddingHeader": "X-Trace",
          "xPaddingPlacement": "header"
        }
      }
    },
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ]
}
